# Neon PostgreSQL connection string (server-side only).
# Never commit the real value; add it in your deployment environment too.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Auth.js (NextAuth v5) with Google as the only provider.
# Generate the secret with: openssl rand -base64 32
AUTH_SECRET=""
# From the Google Cloud OAuth client shared with classlink.
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://study.wyattprice.dev/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
